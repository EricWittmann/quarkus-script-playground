{
  "name": "test-application-ts",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "devDependencies": {
    "cp": "0.2.0",
    "esbuild": "^0.25.4",
    "rimraf": "6.0.1",
    "typescript": "5.8.3"
  },
  "scripts": {
    "clean": "rimraf dist",
    "transpile": "tsc --p ./tsconfig-build.json",
    "build-simple": "esbuild dist/src/main/ts/SimpleTestScript.js --bundle --outfile=dist/simpleTestLibrary.js --format=esm",
    "build-context": "esbuild dist/src/main/ts/ContextTestScript.js --bundle --outfile=dist/contextTestLibrary.js --format=esm",
    "build-beans": "esbuild dist/src/main/ts/BeansTestScript.js --bundle --outfile=dist/beansTestLibrary.js --format=esm",
    "build": "npm run transpile && npm run build-simple && npm run build-context && npm run build-beans"
  },
  "dependencies": {
    "clean": "^4.0.2",
    "run": "^1.5.0"
  }
}
